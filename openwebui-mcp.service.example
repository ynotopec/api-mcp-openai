[Unit]
Description=OpenWebUI MCP / MCPO
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Adjust this path if the repository is cloned elsewhere.
WorkingDirectory=%h/api-mcp-openai
# A fixed port is intentional for service discovery and restart stability.
ExecStart=/bin/bash %h/api-mcp-openai/run.sh 0.0.0.0 8000
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
KillSignal=SIGTERM

[Install]
WantedBy=default.target
